{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CitizenProceduralDefinition",
  "type": "object",
  "required": [
    "model",
    "bones",
    "textures"
  ],
  "properties": {
    "model": {
      "$ref": "#/$defs/resourceLocation"
    },
    "bones": {
      "type": "object",
      "required": [
        "head",
        "left_hand",
        "right_hand",
        "armor"
      ],
      "properties": {
        "head": {
          "type": "string"
        },
        "left_hand": {
          "type": "string"
        },
        "right_hand": {
          "type": "string"
        },
        "armor": {
          "type": "object",
          "required": [
            "head",
            "chest",
            "legs",
            "feet"
          ],
          "properties": {
            "head": {
              "$ref": "#/$defs/stringOrStringArray"
            },
            "chest": {
              "$ref": "#/$defs/stringOrStringArray"
            },
            "legs": {
              "$ref": "#/$defs/stringOrStringArray"
            },
            "feet": {
              "$ref": "#/$defs/stringOrStringArray"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "textures": {
      "type": "object",
      "required": [
        "base"
      ],
      "properties": {
        "armor_override_path": {
          "$ref": "#/$defs/resourceLocation"
        },
        "clothing_override_path": {
          "$ref": "#/$defs/resourceLocation"
        },
        "base": {
          "$ref": "#/$defs/textureLayerBase"
        },
        "overlays": {
          "oneOf": [
            {
              "$ref": "#/$defs/overlayGroup"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/overlayGroup"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachmentGroup"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resourceLocation": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$"
    },
    "stringOrStringArray": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "visibilityRules": {
      "type": "object",
      "properties": {
        "hide_on_armor_slots": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "head",
              "chest",
              "legs",
              "feet"
            ]
          }
        },
        "hide_on_jobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "show_on_jobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "attachmentOption": {
      "type": "object",
      "required": [
        "bone"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "bone": {
          "$ref": "#/$defs/stringOrStringArray"
        },
        "weight": {
          "type": "number",
          "minimum": 0.0,
          "default": 1.0
        },
        "visibility_rules": {
          "$ref": "#/$defs/visibilityRules"
        }
      },
      "additionalProperties": false
    },
    "attachmentGroup": {
      "type": "object",
      "required": [
        "options"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "chance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "exclusive": {
          "type": "boolean",
          "default": true
        },
        "visibility_rules": {
          "$ref": "#/$defs/visibilityRules"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachmentOption"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "colorEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/hexColor"
        },
        {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/hexColor"
            },
            "max": {
              "$ref": "#/$defs/hexColor"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "weightedTextureEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/resourceLocation"
        },
        {
          "type": "object",
          "required": [
            "texture"
          ],
          "properties": {
            "texture": {
              "$ref": "#/$defs/resourceLocation"
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "default": 1.0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "textureLayerBase": {
      "type": "object",
      "required": [
        "textures"
      ],
      "properties": {
        "textures": {
          "oneOf": [
            {
              "$ref": "#/$defs/weightedTextureEntry"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/weightedTextureEntry"
              },
              "minItems": 1
            }
          ]
        },
        "colors": {
          "oneOf": [
            {
              "$ref": "#/$defs/colorEntry"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/colorEntry"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "overlayGroup": {
      "type": "object",
      "required": [
        "textures"
      ],
      "properties": {
        "textures": {
          "oneOf": [
            {
              "$ref": "#/$defs/weightedTextureEntry"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/weightedTextureEntry"
              },
              "minItems": 1
            }
          ]
        },
        "chance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "blend_mode": {
          "type": "string",
          "enum": [
            "normal",
            "multiply",
            "add",
            "overlay"
          ],
          "default": "normal"
        },
        "colors": {
          "oneOf": [
            {
              "$ref": "#/$defs/colorEntry"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/colorEntry"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}